{
  "name": "star-companion",
  "version": "1.0.3",
  "private": true,
  "description": "Local-first AI roleplay chat workspace for web, desktop, and Android.",
  "author": "C-JIAXI",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/C-JIAXI/star-companion.git"
  },
  "homepage": "https://github.com/C-JIAXI/star-companion",
  "bugs": {
    "url": "https://github.com/C-JIAXI/star-companion/issues"
  },
  "packageManager": "npm@11.6.1",
  "type": "module",
  "main": "apps/desktop/main.cjs",
  "scripts": {
    "postinstall": "node scripts/dev/install-subprojects.mjs",
    "dev": "node scripts/dev/ensure-dev-db.mjs && concurrently -n shared,server,web -c cyan,green,magenta \"npm run dev --prefix packages/shared\" \"npm run dev --prefix apps/server\" \"npm run dev --prefix apps/web\"",
    "version:generate": "node scripts/release/generate-version.mjs",
    "version:check": "node scripts/release/check-version.mjs",
    "test:release-tools": "node --test scripts/release/version-core.test.mjs apps/desktop/update-state.test.cjs scripts/migrations/migration-safety.test.mjs scripts/mobile/migration-safety.test.mjs",
    "build": "npm run version:generate && npm run build --prefix packages/shared && npm run build --prefix apps/server && npm run build --prefix apps/web",
    "desktop:icon": "node scripts/desktop/generate-desktop-icon.mjs",
    "desktop:prepare": "npm run desktop:icon && node scripts/desktop/prepare-desktop-resources.mjs",
    "desktop:dev": "npm run desktop:icon && npm run build && electron .",
    "desktop:pack": "npm run build && npm run desktop:prepare && electron-builder --config electron-builder.config.cjs --dir",
    "desktop:build": "npm run build && npm run desktop:prepare && electron-builder --config electron-builder.config.cjs --publish=never && node scripts/release/collect-windows-metadata.mjs",
    "desktop:smoke:packaged": "node --disable-warning=ExperimentalWarning scripts/desktop/smoke-packaged.mjs",
    "desktop:release:preflight": "node scripts/release/preflight-windows-signing.mjs",
    "desktop:release": "npm run desktop:release:preflight && npm run build && npm run desktop:prepare && electron-builder --config electron-builder.release.config.cjs --publish=never && node scripts/release/collect-windows-metadata.mjs",
    "mobile:build:web": "node scripts/mobile/build-mobile-web.mjs",
    "mobile:sync": "npm run mobile:build:web && cap sync android",
    "mobile:open:android": "npm run mobile:sync && cap open android",
    "mobile:build:android": "npm run mobile:sync && node scripts/mobile/run-gradle.mjs assembleDebug",
    "mobile:release:preflight": "node scripts/release/preflight-android-signing.mjs",
    "mobile:build:release": "node scripts/mobile/build-release.mjs",
    "mobile-backend:start": "npm run start --prefix apps/mobile-backend",
    "mobile-backend:smoke": "node scripts/mobile/smoke-mobile-backend.mjs",
    "test:server": "npm run test --prefix apps/server",
    "test:api": "node --disable-warning=ExperimentalWarning scripts/smoke-api.mjs",
    "test:e2e": "npm run test:e2e --prefix apps/web",
    "perf:seed": "node --disable-warning=ExperimentalWarning scripts/perf/seed.mjs",
    "perf:server": "node --disable-warning=ExperimentalWarning scripts/perf/server.mjs",
    "perf:regression": "node --disable-warning=ExperimentalWarning scripts/perf/regression.mjs",
    "perf:web": "node --disable-warning=ExperimentalWarning scripts/perf/web.mjs",
    "perf:mobile": "node --disable-warning=ExperimentalWarning scripts/perf/mobile.mjs",
    "perf:report": "node --disable-warning=ExperimentalWarning scripts/perf/report.mjs",
    "perf:compare": "node --disable-warning=ExperimentalWarning scripts/perf/compare.mjs",
    "lint": "npm run version:check && npm run lint --prefix packages/shared && npm run lint --prefix apps/server && npm run lint --prefix apps/web",
    "release:checksums": "node scripts/release/generate-checksums.mjs",
    "release:verify:windows": "node scripts/release/verify-artifacts.mjs --platform=windows",
    "release:verify:android": "node scripts/release/verify-artifacts.mjs --platform=android",
    "release:check": "node scripts/release/run-release-check.mjs",
    "format": "prettier --write .",
    "db:generate": "npm run db:generate --prefix apps/server",
    "db:init": "node scripts/dev/init-dev-db.mjs",
    "db:push": "npm run db:push --prefix apps/server",
    "db:migrate": "npm run db:migrate --prefix apps/server",
    "db:migrate:deploy": "npm run db:migrate:deploy --prefix apps/server"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "astral-regex": "^2.0.0",
    "capacitor-nodejs": "https://github.com/hampoelz/capacitor-nodejs/releases/download/v1.0.0-beta.10/capacitor-nodejs.tgz",
    "concurrently": "^9.2.1",
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "undici": "^7.29.0"
  },
  "dependencies": {
    "@capacitor/share": "^8.0.1",
    "electron-updater": "^6.6.2"
  },
  "overrides": {
    "electron-updater": {
      "js-yaml": "5.2.3"
    }
  }
}
