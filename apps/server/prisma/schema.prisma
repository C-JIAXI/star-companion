generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model UserSettings {
  id                     String    @id @default(cuid())
  activeProvider         String    @default("openai-compatible")
  apiBaseUrl             String    @default("https://api.openai.com/v1")
  /// Stored locally with application-level AES-256-GCM encryption at rest.
  apiKey                 String?
  model                  String    @default("gpt-4o-mini")
  temperature            Float     @default(0.8)
  maxTokens              Int       @default(800)
  topP                   Float     @default(1)
  /// UI language. Valid values are "zh-CN" and "en".
  language               String    @default("zh-CN")
  /// JSON array of model presets (LEGACY — kept for migration only)
  models                 Json?     @default("[]")
  /// JSON array of provider profiles. API keys are stored AES-256-GCM encrypted and never serialized.
  providers              Json?     @default("[]")
  /// References a ProviderProfile.id within the providers array
  activeProviderId       String?   @default("")
  /// References a ProviderModel.id within the active provider's models array
  activeModelId          String?   @default("")
  /// Per-AI-module provider/model references, e.g. { chat: { providerId, modelId } }
  moduleModelPreferences Json?     @default("{}")
  /// Retry policy and explicitly enabled per-module fallback chains. Never contains secrets.
  modelReliability       Json?     @default("{}")
  /// Local soft/hard spending guardrails, stored in integer micro-USD.
  usageBudgets           Json?     @default("{}")
  /// IANA time zone used for daily and monthly budget boundaries.
  usageTimezone          String    @default("UTC")
  /// Reusable local persona/custom-config presets.
  userPersonaPresets     Json?     @default("[]")
  /// Local user profile memory summarised from user messages.
  userProfileSummary     String    @default("")
  autoSummarizeUser      Boolean   @default(true)
  showMessageAvatars     Boolean   @default(true)
  showMessageTimestamps  Boolean   @default(false)
  ttsVoice               String    @default("alloy")
  ttsPlaybackRate        Float     @default(1.0)
  ttsAutoPlay            Boolean   @default(false)
  userProfileUpdatedAt   DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model Character {
  id           String   @id @default(cuid())
  cardId       String   @unique @default(cuid())
  name         String
  avatar       String?
  description  String   @default("")
  prefix       String   @default("")
  prompt       String   @default("")
  suffix       String   @default("")
  htmlCss      String   @default("")
  openingHtml  String   @default("")
  tags         Json     @default("[]")
  loreEntries  Json     @default("[]")
  quickReplies Json     @default("[]")
  /// Local user preference. Included in backups, excluded from character card exports.
  isFavorite   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  chats    Chat[]
  messages Message[]
}

model Chat {
  id                    String    @id @default(cuid())
  title                 String
  characterId           String?
  /// Origin chat when this chat was created as a branch. No database relation keeps imports portable.
  parentChatId          String?
  /// Message id in the origin chat where this branch was created.
  branchSourceMessageId String?
  /// A saved branch snapshot that does not automatically become the active chat.
  isCheckpoint          Boolean   @default(false)
  /// User-owned history organization flag. It never affects prompt context.
  isPinned              Boolean   @default(false)
  /// Hidden from active history without deleting messages or memories.
  isArchived            Boolean   @default(false)
  /// User-owned history folder. It never affects prompt context or memory retrieval.
  folder                String    @default("")
  /// Soft-deletion marker. Trashed chats retain their messages and memories until permanently deleted.
  deletedAt             DateTime?
  backgroundUrl         String    @default("")
  memoryTurns           Int       @default(12)
  autoMemoryEnabled     Boolean   @default(true)
  memoryUpdatedAt       DateTime?
  /// Explicit user-authored persona / preference notes for this chat.
  userPersona           String    @default("")
  /// Chat-scoped user persona avatar. Omitted from chat-list API responses to avoid large payloads.
  userAvatar            String    @default("")
  userProfileSummary    String    @default("")
  userProfileUpdatedAt  DateTime?
  /// Monotonic pointer to the latest chat-scoped profile summary revision.
  profileRevision       Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  character Character?   @relation(fields: [characterId], references: [id], onDelete: SetNull)
  messages  Message[]
  memories  ChatMemory[]
  memoryOperations MemoryOperation[]
  profileSummaryRevisions ProfileSummaryRevision[]
  modelRequests ModelRequest[]
  usageAttempts ModelUsageAttempt[]

  @@index([characterId])
  @@index([parentChatId])
  @@index([deletedAt, isArchived, folder, isPinned, updatedAt])
}

model ChatMemory {
  id                 String    @id @default(cuid())
  chatId             String
  title              String
  content            String
  keywords           Json      @default("[]")
  importance         Int       @default(3)
  enabled            Boolean   @default(true)
  /// Soft deletion keeps the current tombstone auditable and recoverable.
  deletedAt          DateTime?
  /// Monotonic pointer; pruning old revisions never rewinds this value.
  currentRevision    Int       @default(0)
  lastActor          String?
  lastAction         String?
  sourceMessageIds   Json      @default("[]")
  embedding          Json?
  embeddingModel     String?
  embeddingSource    String?
  embeddingDimensions Int?
  embeddingStatus    String    @default("stale")
  embeddingUpdatedAt DateTime?
  lastMatchedAt      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  revisions MemoryRevision[]

  @@index([chatId])
  @@index([chatId, deletedAt, enabled])
  @@index([chatId, updatedAt])
}

/// Immutable, content-minimal audit event for one ChatMemory state transition.
/// Snapshots intentionally exclude embeddings, prompts, provider responses, persona, and profile text.
model MemoryRevision {
  id               String   @id @default(cuid())
  memoryId         String
  chatId           String
  revision         Int
  action           String
  actor            String
  beforeSnapshot   Json?
  afterSnapshot    Json?
  sourceMessageIds Json     @default("[]")
  operationId      String?
  reasonCode       String
  createdAt        DateTime @default(now())

  memory ChatMemory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@unique([memoryId, revision])
  @@index([chatId, createdAt])
  @@index([memoryId, createdAt])
  @@index([operationId, createdAt])
}

/// Content-free summary for one automatic maintenance or undo batch.
model MemoryOperation {
  id               String   @id @default(cuid())
  chatId           String
  type             String
  actor            String
  status           String
  startedAt        DateTime @default(now())
  completedAt      DateTime?
  createdCount     Int      @default(0)
  updatedCount     Int      @default(0)
  disabledCount    Int      @default(0)
  unchangedCount   Int      @default(0)
  sourceMessageIds Json     @default("[]")
  errorCode        String?
  undoneAt         DateTime?
  undoOperationId  String?

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, startedAt])
  @@index([status, startedAt])
  @@index([undoOperationId])
}

/// Immutable history for the sensitive chat-scoped user profile summary.
model ProfileSummaryRevision {
  id               String   @id @default(cuid())
  chatId           String
  revision         Int
  action           String
  actor            String
  summary          String
  sourceMessageIds Json     @default("[]")
  createdAt        DateTime @default(now())

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([chatId, revision])
  @@index([chatId, createdAt])
}

model Message {
  id                 String   @id @default(cuid())
  chatId             String
  /// Valid values: "user", "assistant", or "system".
  role               String
  characterId        String?
  content            String
  /// Whether this message is included in subsequent model and Agent context.
  contextIncluded    Boolean  @default(true)
  /// User-owned navigation marker. It never affects model or Agent context.
  isBookmarked       Boolean  @default(false)
  variants           Json     @default("[]")
  activeVariantIndex Int      @default(0)
  tokenUsage         Json?
  /// Content-free provider/model/cost summary for the active generated variant.
  generationMetadata Json?
  /// Variant-aligned content-free provider/model/usage summaries.
  variantMetadata    Json      @default("[]")
  /// Token-only itemization of the prompt used to generate this assistant message.
  promptBreakdown    Json?
  loreMatches        Json?
  memoryMatches      Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  chat      Chat       @relation(fields: [chatId], references: [id], onDelete: Cascade)
  character Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  modelRequests ModelRequest[]
  usageAttempts ModelUsageAttempt[]
  attachments MessageAttachment[]

  @@index([chatId])
  @@index([chatId, createdAt])
  @@index([chatId, isBookmarked, createdAt])
  @@index([characterId])
}

/// Immutable, content-addressed image bytes. Original paths and untrusted metadata are never stored.
model MediaAsset {
  id          String   @id @default(cuid())
  contentHash String   @unique
  mimeType    String
  byteSize    Int
  width       Int
  height      Int
  storageKey  String   @unique
  data        Bytes
  createdAt   DateTime @default(now())

  attachments MessageAttachment[]
  recoveryPoints RecoveryPointMediaAsset[]

  @@index([createdAt])
}

/// Ordered reference from a sent message or a controlled temporary draft to an immutable asset.
model MessageAttachment {
  id               String   @id @default(cuid())
  messageId        String?
  draftId          String?
  assetId          String
  sortOrder        Int
  originalFilename String?
  createdAt        DateTime @default(now())

  message Message?   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  asset   MediaAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([messageId, sortOrder])
  @@index([draftId, sortOrder])
  @@index([assetId])
  @@unique([messageId, sortOrder])
  @@unique([draftId, sortOrder])
}

/// Content-free lifecycle record used for reconnect recovery and application-level deduplication.
model ModelRequest {
  id                String   @id
  module            String
  operation         String
  chatId            String?
  messageId         String?
  status            String   @default("queued")
  activeAttemptId   String?
  outputStarted     Boolean  @default(false)
  errorCode         String?
  errorSummary      String?
  diagnosticId      String?
  overrideHardBudget Boolean @default(false)
  createdAt         DateTime @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  updatedAt         DateTime @updatedAt

  chat     Chat?    @relation(fields: [chatId], references: [id], onDelete: SetNull)
  message  Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  attempts ModelUsageAttempt[]

  @@index([status, updatedAt])
  @@index([chatId, createdAt])
  @@index([module, createdAt])
}

/// One row per actual provider call. It never stores prompts, output text, or raw provider errors.
model ModelUsageAttempt {
  id                    String   @id
  requestId             String
  attemptNumber         Int
  module                String
  chatId                String?
  messageId             String?
  providerId            String
  providerType          String
  modelId               String
  status                String   @default("running")
  startedAt             DateTime @default(now())
  completedAt           DateTime?
  promptTokens          Int?
  outputTokens          Int?
  totalTokens           Int?
  usageSource           String?
  inputPriceMicros      Int?
  outputPriceMicros     Int?
  estimatedCostMicros   Int?
  currency              String?
  specialTokensUnknown  Boolean  @default(false)
  usedFallback          Boolean  @default(false)
  fallbackFromProviderId String?
  fallbackFromModelId   String?
  errorCode             String?
  diagnosticId          String?
  reservedCostMicros    Int      @default(0)
  reservationDay        String?
  reservationMonth      String?

  request ModelRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  chat    Chat?        @relation(fields: [chatId], references: [id], onDelete: SetNull)
  message Message?     @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@unique([requestId, attemptNumber])
  @@index([startedAt])
  @@index([module, startedAt])
  @@index([providerId, modelId, startedAt])
  @@index([chatId, startedAt])
  @@index([reservationDay, status])
  @@index([reservationMonth, status])
}

/// Local, bounded safety snapshot created before destructive data protection operations.
/// The snapshot uses backup schemaVersion 1 and never contains API keys.
model RecoveryPoint {
  id        String   @id @default(cuid())
  reason    String
  summary   Json
  snapshot  Json
  createdAt DateTime @default(now())
  mediaAssets RecoveryPointMediaAsset[]

  @@index([createdAt])
}

/// Keeps deduplicated media alive for a bounded recovery point without copying bytes into JSON snapshots.
model RecoveryPointMediaAsset {
  recoveryPointId String
  assetId         String

  recoveryPoint RecoveryPoint @relation(fields: [recoveryPointId], references: [id], onDelete: Cascade)
  asset         MediaAsset    @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([recoveryPointId, assetId])
  @@index([assetId])
}
