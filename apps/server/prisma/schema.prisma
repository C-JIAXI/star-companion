generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model UserSettings {
  id                   String    @id @default(cuid())
  activeProvider       String    @default("openai-compatible")
  apiBaseUrl           String    @default("https://api.openai.com/v1")
  /// Stored locally with application-level AES-256-GCM encryption at rest.
  apiKey               String?
  model                String    @default("gpt-4o-mini")
  temperature          Float     @default(0.8)
  maxTokens            Int       @default(800)
  topP                 Float     @default(1)
  /// UI language. Valid values are "zh-CN" and "en".
  language             String    @default("zh-CN")
  /// JSON array of model presets (LEGACY — kept for migration only)
  models               Json?     @default("[]")
  /// JSON array of provider profiles: [{ id, label, provider, apiBaseUrl, key, models }]
  providers            Json?     @default("[]")
  /// References a ProviderProfile.id within the providers array
  activeProviderId     String?   @default("")
  /// References a ProviderModel.id within the active provider's models array
  activeModelId        String?   @default("")
  /// Local user profile memory summarised from user messages.
  userProfileSummary   String    @default("")
  autoSummarizeUser    Boolean   @default(true)
  showMessageAvatars   Boolean   @default(true)
  userProfileUpdatedAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Character {
  id           String   @id @default(cuid())
  name         String
  avatar       String?
  description  String   @default("")
  prefix       String   @default("")
  prompt       String   @default("")
  suffix       String   @default("")
  htmlCss      String   @default("")
  openingHtml  String   @default("")
  loreEntries  Json     @default("[]")
  quickReplies Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  chats    Chat[]
  messages Message[]
}

model Chat {
  id                   String    @id @default(cuid())
  title                String
  characterId          String?
  backgroundUrl        String    @default("")
  memoryTurns          Int       @default(12)
  autoMemoryEnabled    Boolean   @default(true)
  memoryUpdatedAt      DateTime?
  /// Explicit user-authored persona / preference notes for this chat.
  userPersona          String    @default("")
  userProfileSummary   String    @default("")
  userProfileUpdatedAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  character Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  messages  Message[]
  memories  ChatMemory[]

  @@index([characterId])
}

model ChatMemory {
  id               String    @id @default(cuid())
  chatId           String
  title            String
  content          String
  keywords         Json      @default("[]")
  importance       Int       @default(3)
  enabled          Boolean   @default(true)
  sourceMessageIds Json      @default("[]")
  lastMatchedAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@index([chatId, enabled])
  @@index([chatId, updatedAt])
}

model Message {
  id                 String   @id @default(cuid())
  chatId             String
  /// Valid values: "user", "assistant", or "system".
  role               String
  characterId        String?
  content            String
  variants           Json     @default("[]")
  activeVariantIndex Int      @default(0)
  tokenUsage         Json?
  loreMatches        Json?
  memoryMatches      Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  chat      Chat       @relation(fields: [chatId], references: [id], onDelete: Cascade)
  character Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@index([chatId])
  @@index([chatId, createdAt])
  @@index([characterId])
}
